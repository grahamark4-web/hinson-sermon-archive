{
  "name": "hinson-sermon-archive-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/archive-audio/*",
      "/download/*",
      "/api/transcript-search"
    ]
  }
}
